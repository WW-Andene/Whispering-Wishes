# Required: Groq API key (free at https://console.groq.com/keys)
GROQ_API_KEY=gsk_...

# Dashboard auth token — set this to a random string, use it in WW-B agent config
# Anyone with this token can push findings and read the dashboard
DASHBOARD_TOKEN=change-me-to-something-random

# Optional: Port (default 3001)
# PORT=3001
