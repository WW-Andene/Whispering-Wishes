{
  "compilerOptions": {
    "baseUrl": ".",
    "checkJs": true,
    "strict": false,
    "jsx": "react-jsx",
    "target": "ES2022",
    "module": "ES2022",
    "moduleResolution": "bundler",
    "paths": {
      "@data/*": ["src/data/*"],
      "@features/*": ["src/features/*"]
    }
  },
  "include": ["src/**/*.js", "src/**/*.jsx"],
  "exclude": ["node_modules", "dist"]
}
