# Copy this file to self-host/.env and fill in the values you need.
# self-host/.env is gitignored — never commit real keys.

# Port + bind address for the self-host server (self-host/server.js)
PORT=4173
HOST=0.0.0.0

# Required for the "remove background" feature (Collection tab image editing)
# and the admin batch background-removal tool. Get a free key at
# https://huggingface.co/settings/tokens
HF_API_KEY=

# Required for the "scan gacha URL from screenshot" OCR import feature.
# Get a free key at https://console.groq.com/keys
GROQ_API_KEY=

# Required only if you use the admin panel's batch background-removal tool.
# Must match whatever hash the admin panel is configured to check.
ADMIN_HASH=

# Extra origins allowed to call /api/* (comma-separated, no spaces around the
# commas needed). http://localhost:4173 (this server's default port) is
# already allowed without needing to list it — see api/_common.js. Add
# whatever OTHER URL you'll actually load the app FROM — e.g. your Cloudflare
# Tunnel URL, or a LAN address if PORT/HOST differ from the defaults above:
#   EXTRA_ALLOWED_ORIGINS=https://your-tunnel.trycloudflare.com,http://192.168.1.50:4173
EXTRA_ALLOWED_ORIGINS=

# Optional: disable specific features without restarting (set to "true").
# Same switches the Vercel deployment supports — see api/_common.js.
# SERVICE_DISABLED=true
# SERVICE_DISABLED_OCR=true
# SERVICE_DISABLED_REMOVE_BG=true
# SERVICE_DISABLED_GACHA=true
