# Firebase Realtime Database configuration
# Set these in your environment (Vercel dashboard, .env.local, etc.)
# The app falls back to hardcoded defaults if these are not set.
VITE_FIREBASE_DB=https://your-project.firebaseio.com
VITE_FIREBASE_API_KEY=your-api-key-here
# Google OAuth Client ID (from Firebase Console → Auth → Sign-in method → Google → Web client ID)
VITE_GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
