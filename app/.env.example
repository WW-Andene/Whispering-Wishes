# Whispering Wishes — Environment Variables
# Copy this file to .env and fill in your values.
# These are also set in Vercel Dashboard → Project Settings → Environment Variables.

# Firebase Realtime Database URL (required for leaderboard, cloud backup, presence)
VITE_FIREBASE_DB=https://your-project.firebaseio.com

# Firebase API Key (required for anonymous auth + Google sign-in)
VITE_FIREBASE_API_KEY=AIzaSy...

# Google OAuth Client ID (required for Google Sign-In / Cloud Backup on the WEB build) —
# a "Web application" client in Google Cloud Console, used by the Google Identity Services
# popup flow (CloudStorageProvider.jsx's getGoogleAccessTokenWeb).
VITE_GOOGLE_CLIENT_ID=123456789-abc.apps.googleusercontent.com

# Google OAuth Client ID for the NATIVE (Android) build's Cloud Backup sign-in — a separate
# client because Google blocks its OAuth pages from loading inside an embedded WebView at all,
# so the native app instead opens the system browser and gets redirected back via a custom
# URL scheme (cc.andene.whisperingwishes://oauth-callback, see CloudStorageProvider.jsx's
# getGoogleAccessTokenNative and MainActivity's intent-filter in AndroidManifest.xml) — only a
# client of type "iOS" (the conventional choice for custom-scheme redirects, works fine for a
# non-iOS app), "Android", "Desktop", or "TVs and Limited Input devices" can redirect to a
# non-https:// URI; the "Web application" client above cannot. Create this client in Google
# Cloud Console → Credentials, register the exact redirect URI above, and set it here.
VITE_GOOGLE_CLIENT_ID_NATIVE=123456789-xyz.apps.googleusercontent.com

# --- Server-side only (set in Vercel env vars, NOT prefixed with VITE_) ---
# HF_API_KEY=hf_...             # HuggingFace API for background removal
# ADMIN_HASH=sha256...          # Admin panel password hash (PBKDF2)
