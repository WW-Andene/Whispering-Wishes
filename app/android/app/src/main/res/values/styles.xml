<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!-- Base application theme. -->
    <style name="AppTheme" parent="Theme.AppCompat.Light.DarkActionBar">
        <!-- Customize your theme here. -->
        <item name="colorPrimary">@color/colorPrimary</item>
        <item name="colorPrimaryDark">@color/colorPrimaryDark</item>
        <item name="colorAccent">@color/colorAccent</item>
    </style>

    <style name="AppTheme.NoActionBar" parent="Theme.AppCompat.DayNight.NoActionBar">
        <item name="windowActionBar">false</item>
        <item name="windowNoTitle">true</item>
        <item name="android:windowBackground">@color/app_background</item>
        <!-- Forced OUT of edge-to-edge entirely (see MainActivity.java's
             setDecorFitsSystemWindows(true) + windowOptOutEdgeToEdgeEnforcement
             below) — targetSdk 35+ enforces edge-to-edge by default and this
             attribute is the only sanctioned opt-out. With the system
             reserving real, static space for the status/nav bars from the
             very first frame, there's no WindowInsets round-trip for the
             WebView to wait on and nothing to visually resize into later —
             the whole contained -> edge-to-edge -> settled sequence this was
             chasing simply can't happen if the window is never edge-to-edge
             in the first place. Bars painted opaque in the app's own
             background color (not transparent) since content no longer
             draws underneath them. -->
        <item name="android:windowOptOutEdgeToEdgeEnforcement">true</item>
        <item name="android:statusBarColor">@color/app_background</item>
        <item name="android:navigationBarColor">@color/app_background</item>
        <item name="android:windowLightStatusBar">false</item>
    </style>


    <style name="AppTheme.NoActionBarLaunch" parent="Theme.SplashScreen">
        <item name="android:background">@drawable/splash</item>
        <!-- Matches AppTheme.NoActionBar above — same opt-out, same opaque
             bar colors — so the splash window and the real app window are
             in the same (non-edge-to-edge) mode from the very first frame,
             with nothing for MainActivity.onCreate() to switch. -->
        <item name="android:windowOptOutEdgeToEdgeEnforcement">true</item>
        <item name="android:statusBarColor">@color/app_background</item>
        <item name="android:navigationBarColor">@color/app_background</item>
        <item name="android:windowLightStatusBar">false</item>
    </style>

    <!-- ConveneAnimationActivity — full-screen black, no action bar/title,
         launched from BannerWidget.java's ▶️ button. -->
    <style name="AppTheme.ConveneOverlay" parent="Theme.AppCompat.NoActionBar">
        <item name="windowActionBar">false</item>
        <item name="windowNoTitle">true</item>
        <item name="android:windowBackground">@android:color/black</item>
        <item name="android:windowFullscreen">true</item>
        <item name="android:statusBarColor">@android:color/black</item>
        <item name="android:navigationBarColor">@android:color/black</item>
    </style>
</resources>