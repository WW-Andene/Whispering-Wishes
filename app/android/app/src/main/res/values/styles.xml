<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!-- Base application theme. -->
    <style name="AppTheme" parent="Theme.AppCompat.Light.DarkActionBar">
        <!-- Customize your theme here. -->
        <item name="colorPrimary">@color/colorPrimary</item>
        <item name="colorPrimaryDark">@color/colorPrimaryDark</item>
        <item name="colorAccent">@color/colorAccent</item>
    </style>

    <style name="AppTheme.NoActionBar" parent="Theme.AppCompat.DayNight.NoActionBar">
        <item name="windowActionBar">false</item>
        <item name="windowNoTitle">true</item>
        <item name="android:windowBackground">@color/app_background</item>
        <!-- Explicit transparent status/nav bars — MainActivity already calls
             setDecorFitsSystemWindows(false) so the WebView draws full-bleed
             underneath them, but that alone doesn't stop the OS from painting
             an opaque default color there too; without this, whatever
             AppCompat.DayNight.NoActionBar falls back to (not this app's navy)
             sits on top of the content instead of letting it show through. -->
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">false</item>
        <!-- Declared here, not just via MainActivity's
             WindowCompat.setDecorFitsSystemWindows(false) call — theme
             attributes are applied by the OS the instant it creates the
             window, before ANY Activity code runs, which is strictly
             earlier than even the first line of onCreate(). Without these,
             there's a real (if brief) first frame where the window is
             still in its default "contained under the status bar" size,
             before the Java call takes effect a moment later — anything
             that paints during that gap (e.g. the boot poster, which
             paints on literally the first frame) lays out for the smaller
             area and then visibly doesn't fill the final one. Declaring
             translucent status/nav here means the window is already
             edge-to-edge from the very first frame the OS ever draws, so
             there's no smaller size left for anything to get caught in. -->
        <item name="android:windowTranslucentStatus">true</item>
        <item name="android:windowTranslucentNavigation">true</item>
    </style>


    <!-- Splash theme's bar treatment must match AppTheme.NoActionBar's
         exactly (transparent status/nav, dark icons) — otherwise the switch
         from this theme to the real one at the end of onCreate() is a real
         compositor-level transition (opaque bars -> transparent, contained
         -> edge-to-edge), which is what produced the visible reframe/jump
         even after the WebView-side inset fix below. Matching them here
         means there's no bar-state change left to animate through. -->
    <style name="AppTheme.NoActionBarLaunch" parent="Theme.SplashScreen">
        <item name="android:background">@drawable/splash</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowDrawsSystemBarBackgrounds">true</item>
        <!-- Matches AppTheme.NoActionBar's own translucent flags (see there
             for the full rationale) — keeps this theme edge-to-edge from
             its own first frame too, so the swap to the real theme has one
             less thing to change. -->
        <item name="android:windowTranslucentStatus">true</item>
        <item name="android:windowTranslucentNavigation">true</item>
    </style>

    <!-- ConveneAnimationActivity — full-screen black, no action bar/title,
         launched from BannerWidget.java's ▶️ button. -->
    <style name="AppTheme.ConveneOverlay" parent="Theme.AppCompat.NoActionBar">
        <item name="windowActionBar">false</item>
        <item name="windowNoTitle">true</item>
        <item name="android:windowBackground">@android:color/black</item>
        <item name="android:windowFullscreen">true</item>
        <item name="android:statusBarColor">@android:color/black</item>
        <item name="android:navigationBarColor">@android:color/black</item>
    </style>
</resources>