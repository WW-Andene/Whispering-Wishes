<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!-- Base application theme. -->
    <style name="AppTheme" parent="Theme.AppCompat.Light.DarkActionBar">
        <!-- Customize your theme here. -->
        <item name="colorPrimary">@color/colorPrimary</item>
        <item name="colorPrimaryDark">@color/colorPrimaryDark</item>
        <item name="colorAccent">@color/colorAccent</item>
    </style>

    <style name="AppTheme.NoActionBar" parent="Theme.AppCompat.DayNight.NoActionBar">
        <item name="windowActionBar">false</item>
        <item name="windowNoTitle">true</item>
        <!-- The boot poster's own first frame (app/public/boot-intro/boot-intro-poster.gif,
             extracted to drawable-nodpi/boot_poster.png) — not @color/app_background.
             MainActivity.java documents the WebView's own render surface briefly
             resizing as edge-to-edge insets settle; anything painted BY THE WEBVIEW
             during that window (the HTML poster included) can catch that resize and
             visibly snap. This windowBackground is a different, unrelated layer —
             painted directly by the OS at the Activity window/DecorView level,
             before the WebView even exists inside it, sized to the real window
             bounds from the first frame the OS ever draws. It isn't subject to the
             WebView's internal resize at all. So instead of showing a plain color
             (or nothing) underneath while the WebView's own poster is still
             potentially catching that resize, what's visible for those first few
             frames is already the right image — no separate "default boot screen"
             moment for the WebView content to visibly replace. -->
        <item name="android:windowBackground">@drawable/boot_poster</item>
        <!-- Explicit transparent status/nav bars — MainActivity already calls
             setDecorFitsSystemWindows(false) so the WebView draws full-bleed
             underneath them, but that alone doesn't stop the OS from painting
             an opaque default color there too; without this, whatever
             AppCompat.DayNight.NoActionBar falls back to (not this app's navy)
             sits on top of the content instead of letting it show through. -->
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">false</item>
        <!-- windowTranslucentStatus/Navigation — real, valid, declarative
             attributes (unlike windowFitsSystemWindows, which doesn't exist
             and broke CI). These are what actually control whether the
             window reserves space for the bars, applied by the OS at
             window creation, with zero code lag — unlike MainActivity's
             WindowCompat.setDecorFitsSystemWindows(false) call, which can
             only run a frame after the window already exists. Tried once
             before (reverted) while windowBackground still pointed at the
             wrong placeholder asset — that test was confounded by an
             unrelated bug, not a real result. Retrying now that the asset
             is actually correct. -->
        <item name="android:windowTranslucentStatus">true</item>
        <item name="android:windowTranslucentNavigation">true</item>
    </style>


    <!-- Splash theme's bar treatment must match AppTheme.NoActionBar's
         exactly (transparent status/nav, dark icons) — otherwise the switch
         from this theme to the real one at the end of onCreate() is a real
         compositor-level transition (opaque bars -> transparent, contained
         -> edge-to-edge), which is what produced the visible reframe/jump
         even after the WebView-side inset fix below. Matching them here
         means there's no bar-state change left to animate through.

         android:background was @drawable/splash — an old, unrelated navy
         placeholder asset from before the boot poster/video existed. This
         theme is what the OS actually shows FIRST, before MainActivity's
         onCreate() (and therefore setTheme(AppTheme_NoActionBar)) has run
         at all, so leaving the old asset here meant the very first thing
         on screen was never the poster, no matter what AppTheme.NoActionBar
         declared. Pointed at the same @drawable/boot_poster now. -->
    <style name="AppTheme.NoActionBarLaunch" parent="Theme.SplashScreen">
        <item name="android:background">@drawable/boot_poster</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowDrawsSystemBarBackgrounds">true</item>
        <!-- Same reasoning as AppTheme.NoActionBar's own translucent flags —
             retrying now that this theme's own windowBackground is
             actually the boot poster instead of the old placeholder. -->
        <item name="android:windowTranslucentStatus">true</item>
        <item name="android:windowTranslucentNavigation">true</item>
    </style>

    <!-- ConveneAnimationActivity — full-screen black, no action bar/title,
         launched from BannerWidget.java's ▶️ button. -->
    <style name="AppTheme.ConveneOverlay" parent="Theme.AppCompat.NoActionBar">
        <item name="windowActionBar">false</item>
        <item name="windowNoTitle">true</item>
        <item name="android:windowBackground">@android:color/black</item>
        <item name="android:windowFullscreen">true</item>
        <item name="android:statusBarColor">@android:color/black</item>
        <item name="android:navigationBarColor">@android:color/black</item>
    </style>
</resources>