<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!-- Base application theme. -->
    <style name="AppTheme" parent="Theme.AppCompat.Light.DarkActionBar">
        <!-- Customize your theme here. -->
        <item name="colorPrimary">@color/colorPrimary</item>
        <item name="colorPrimaryDark">@color/colorPrimaryDark</item>
        <item name="colorAccent">@color/colorAccent</item>
    </style>

    <style name="AppTheme.NoActionBar" parent="Theme.AppCompat.DayNight.NoActionBar">
        <item name="windowActionBar">false</item>
        <item name="windowNoTitle">true</item>
        <item name="android:windowBackground">@color/app_background</item>
        <!-- Explicit transparent status/nav bars — MainActivity already calls
             setDecorFitsSystemWindows(false) so the WebView draws full-bleed
             underneath them, but that alone doesn't stop the OS from painting
             an opaque default color there too; without this, whatever
             AppCompat.DayNight.NoActionBar falls back to (not this app's navy)
             sits on top of the content instead of letting it show through. -->
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">false</item>
    </style>


    <style name="AppTheme.NoActionBarLaunch" parent="Theme.SplashScreen">
        <item name="android:background">@drawable/splash</item>
        <!-- Without these, this splash window renders as a classic
             non-edge-to-edge window (opaque status bar, content "contained"
             beneath it) while AppTheme.NoActionBar below — the real app
             theme MainActivity switches to in onCreate() — is edge-to-edge
             with transparent bars. That mismatch is a real native window
             mode change, visible as a "contained -> edge-to-edge" jump the
             instant the theme switches, on top of (and separate from) the
             header/nav margin correction already fixed via safe-area inset
             timing. Matching these here so the splash window already looks
             edge-to-edge/transparent removes that first jump entirely. -->
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">false</item>
    </style>

    <!-- ConveneAnimationActivity — full-screen black, no action bar/title,
         launched from BannerWidget.java's ▶️ button. -->
    <style name="AppTheme.ConveneOverlay" parent="Theme.AppCompat.NoActionBar">
        <item name="windowActionBar">false</item>
        <item name="windowNoTitle">true</item>
        <item name="android:windowBackground">@android:color/black</item>
        <item name="android:windowFullscreen">true</item>
        <item name="android:statusBarColor">@android:color/black</item>
        <item name="android:navigationBarColor">@android:color/black</item>
    </style>
</resources>