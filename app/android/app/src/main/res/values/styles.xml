<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!-- Base application theme. -->
    <style name="AppTheme" parent="Theme.AppCompat.Light.DarkActionBar">
        <!-- Customize your theme here. -->
        <item name="colorPrimary">@color/colorPrimary</item>
        <item name="colorPrimaryDark">@color/colorPrimaryDark</item>
        <item name="colorAccent">@color/colorAccent</item>
    </style>

    <style name="AppTheme.NoActionBar" parent="Theme.AppCompat.DayNight.NoActionBar">
        <item name="windowActionBar">false</item>
        <item name="windowNoTitle">true</item>
        <!-- A flat color sampled from the boot poster's own edge tone
             (@color/boot_poster_bg), NOT the poster image itself
             (@drawable/boot_poster — tried in PR #213). The image version
             created a worse problem than it solved: a BitmapDrawable used
             as windowBackground scales with default "fill" (stretch)
             behavior, while the WebView's own HTML poster scales with CSS
             object-fit:cover (crop). Two independently-scaled copies of the
             same source image, at different mappings — wherever the
             hand-off between this native layer and the WebView's own
             content becomes visible (the status bar strip especially,
             which may only ever show this native layer), there's a visible
             seam/reframe between the two, purely from the scaling
             mismatch. The video never has this problem: it's the ONLY
             representation of itself, rendered exclusively by the WebView,
             with nothing else to hand off from or mismatch against. A flat
             color has no scaling to mismatch — matching the poster's own
             tone means the moment before the WebView's content paints is
             just imperceptible, not visually "wrong" the way a
             differently-cropped copy of the same picture is. -->
        <item name="android:windowBackground">@color/boot_poster_bg</item>
        <!-- Explicit transparent status/nav bars — MainActivity already calls
             setDecorFitsSystemWindows(false) so the WebView draws full-bleed
             underneath them, but that alone doesn't stop the OS from painting
             an opaque default color there too; without this, whatever
             AppCompat.DayNight.NoActionBar falls back to (not this app's navy)
             sits on top of the content instead of letting it show through. -->
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowTranslucentStatus">true</item>
        <item name="android:windowTranslucentNavigation">true</item>
    </style>


    <!-- Splash theme's bar treatment must match AppTheme.NoActionBar's
         exactly (transparent status/nav, dark icons) — otherwise the switch
         from this theme to the real one at the end of onCreate() is a real
         compositor-level transition (opaque bars -> transparent, contained
         -> edge-to-edge), which is what produced the visible reframe/jump
         even after the WebView-side inset fix below. Matching them here
         means there's no bar-state change left to animate through.

         android:background was @drawable/splash, then @drawable/boot_poster
         (PR #213) — same flat-color reasoning as AppTheme.NoActionBar's own
         windowBackground applies here too: a stretched native copy of the
         poster and the WebView's cropped copy don't match, and this theme
         is what the OS shows before MainActivity.onCreate() has run at
         all, so any mismatch here is the very first thing on screen. -->
    <style name="AppTheme.NoActionBarLaunch" parent="Theme.SplashScreen">
        <item name="android:background">@color/boot_poster_bg</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowDrawsSystemBarBackgrounds">true</item>
        <item name="android:windowTranslucentStatus">true</item>
        <item name="android:windowTranslucentNavigation">true</item>
    </style>

    <!-- ConveneAnimationActivity — full-screen black, no action bar/title,
         launched from PulseBannerWidget.java's ▶️ button. -->
    <style name="AppTheme.ConveneOverlay" parent="Theme.AppCompat.NoActionBar">
        <item name="windowActionBar">false</item>
        <item name="windowNoTitle">true</item>
        <item name="android:windowBackground">@android:color/black</item>
        <item name="android:windowFullscreen">true</item>
        <item name="android:statusBarColor">@android:color/black</item>
        <item name="android:navigationBarColor">@android:color/black</item>
    </style>
</resources>