<?xml version="1.0" encoding="utf-8"?>
<!-- Small translucent capsule background for the widget's ×1/×10 pull
     buttons — same idea as the app's own .kuro-btn-sm pill (CLAUDE.md's
     PerfectSuite: radius = 0.24×height; these buttons are 24dp tall, so
     0.24×24=5.76, nearest suite value 6). -->
<shape xmlns:android="http://schemas.android.com/apk/res/android">
    <solid android:color="#33FFFFFF" />
    <stroke android:width="1dp" android:color="#4DFFFFFF" />
    <corners android:radius="6dp" />
</shape>
