<?xml version="1.0" encoding="utf-8"?>
<!-- Bottom-to-transparent gradient sitting over the banner art, same idea as
     BannerCard.jsx's BANNER_CARD_OVERLAY_STYLE gradient — keeps the name/
     title/featured-4★ row readable over arbitrary art. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android">
    <gradient
        android:type="linear"
        android:angle="90"
        android:startColor="#00080c14"
        android:centerColor="#B3080c14"
        android:endColor="#E6080c14" />
</shape>
