<?xml version="1.0" encoding="utf-8"?>
<!-- Decorative waveform accent for the amber "screen" panel — a static zigzag, not a real
     audio visualizer (RemoteViews can't animate per-frame audio data), echoing the reference
     art's oscillating trace line on its yellow readout. -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="64dp"
    android:height="16dp"
    android:viewportWidth="64"
    android:viewportHeight="16">
    <path
        android:pathData="M0,8 L6,3 L12,13 L18,5 L24,11 L30,2 L36,14 L42,6 L48,10 L54,4 L60,8 L64,8"
        android:strokeColor="#5A4020"
        android:strokeWidth="1.6"
        android:fillColor="#00000000" />
</vector>
