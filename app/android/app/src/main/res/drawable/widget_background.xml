<?xml version="1.0" encoding="utf-8"?>
<!-- Matches the app's dark card background (colors.xml's app_background /
     capacitor.config.json's backgroundColor: #0c0818) with rounded corners
     — Android 12+ ignores this in favor of the system's themed widget
     background, but it's the real fallback rendered on API 24-31. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android">
    <solid android:color="#0c0818" />
    <corners android:radius="16dp" />
</shape>
