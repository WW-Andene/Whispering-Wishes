<?xml version="1.0" encoding="utf-8"?>
<!-- Rounded card background for the floating overlay banner — same corner
     radius language as widget_background.xml, but this is a real View so
     clipToOutline (set on floating_root in floating_banner.xml) can actually
     clip the art/video/scrim children to these rounded corners, unlike a
     RemoteViews ImageView. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android">
    <solid android:color="#0c0818" />
    <corners android:radius="16dp" />
</shape>
