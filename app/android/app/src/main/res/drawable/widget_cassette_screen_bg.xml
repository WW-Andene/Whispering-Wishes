<?xml version="1.0" encoding="utf-8"?>
<!-- The cassette's amber "display" panel — houses the track name + waveform motif in
     widget_soundtrack.xml, echoing the reference art's yellow readout screen against the
     cream chassis (widget_cassette_background.xml). -->
<shape xmlns:android="http://schemas.android.com/apk/res/android">
    <gradient
        android:angle="90"
        android:startColor="#E8C24A"
        android:endColor="#C99A2E" />
    <corners android:radius="8dp" />
    <stroke
        android:width="1dp"
        android:color="#8A6A3D" />
</shape>
