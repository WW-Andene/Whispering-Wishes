<?xml version="1.0" encoding="utf-8"?>
<!-- Plain chevron-left arrow — the pull bubble's "back" affordance (PullBubbleService.java)
     when navigating out of its banner-picker's Category/List sub-arcs, back toward the normal
     ×1/×10/×80 arc. Also reused (rotated via ImageView.setRotation) as the hide sub-bubble's
     outward-pointing icon and the restore tab's inward-pointing one, so hide/restore/back all
     share this one chevron drawable instead of separate fixed-direction assets. -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="24dp"
    android:height="24dp"
    android:viewportWidth="24"
    android:viewportHeight="24">
    <path
        android:fillColor="#FFFFFF"
        android:pathData="M15,6 L9,12 L15,18 L16.4,16.6 L11.8,12 L16.4,7.4 Z" />
</vector>
