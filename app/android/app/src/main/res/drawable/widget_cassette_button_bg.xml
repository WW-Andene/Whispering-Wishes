<?xml version="1.0" encoding="utf-8"?>
<!-- Small tan "tab" background for the transport buttons — echoes the reference art's raised
     side buttons instead of the fully transparent/dark-themed backgrounds other widgets'
     transport rows use (those read fine on a dark card; invisible on this widget's light
     cream chassis). -->
<shape xmlns:android="http://schemas.android.com/apk/res/android">
    <solid android:color="#D8C398" />
    <corners android:radius="8dp" />
    <stroke
        android:width="1dp"
        android:color="#8A6A3D" />
</shape>
