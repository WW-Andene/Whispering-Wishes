<?xml version="1.0" encoding="utf-8"?>
<!-- Shuffle toggle for the Soundtrack widget's control row — lucide-react's own "Shuffle"
     glyph (two crossing paths with arrowheads), redrawn as a stroke-based vector drawable
     since RemoteViews can't reference the app's SVG icons — same approach as
     ic_loop_widget.xml. Single neutral color regardless of on/off state —
     SoundtrackWidget toggles widget_soundtrack_shuffle_selected's own background visibility
     for the "on" highlight, same stacked-overlay convention the loop toggle already uses. -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="24dp"
    android:height="24dp"
    android:viewportWidth="24"
    android:viewportHeight="24">
    <path
        android:strokeColor="#E5E7EB"
        android:strokeWidth="2"
        android:strokeLineCap="round"
        android:strokeLineJoin="round"
        android:pathData="M16,3 L21,3 L21,8" />
    <path
        android:strokeColor="#E5E7EB"
        android:strokeWidth="2"
        android:strokeLineCap="round"
        android:strokeLineJoin="round"
        android:pathData="M4,20 L21,3" />
    <path
        android:strokeColor="#E5E7EB"
        android:strokeWidth="2"
        android:strokeLineCap="round"
        android:strokeLineJoin="round"
        android:pathData="M21,16 L21,21 L16,21" />
    <path
        android:strokeColor="#E5E7EB"
        android:strokeWidth="2"
        android:strokeLineCap="round"
        android:strokeLineJoin="round"
        android:pathData="M15,15 L21,21" />
    <path
        android:strokeColor="#E5E7EB"
        android:strokeWidth="2"
        android:strokeLineCap="round"
        android:strokeLineJoin="round"
        android:pathData="M4,4 L9,9" />
</vector>
