<?xml version="1.0" encoding="utf-8"?>
<!-- Home-screen "pull target" widget — mode 3 of the Calculator-widget series (see
     TargetWidget.java's own header). Fixed 3x5 size, not resizable — three big equally-
     tall tappable choices (Resonator / Both / Weapon), each a FrameLayout stacking an
     always-visible base card (widget_target_choice_bg) under a colored selected overlay
     that's toggled VISIBLE/GONE by TargetWidget.java depending on which mode is current.
     The outer FrameLayout itself carries the PendingIntent
     (RemoteViews.setOnClickPendingIntent works on any inflated view, not just Button/
     ImageButton).

     No plain <View> anywhere (RemoteViews' allowlist doesn't include it — see
     widget_banner.xml's own comment on this) — the base/selected background layers are
     empty FrameLayouts instead, same pattern as widget_banner.xml's own scrim. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@drawable/widget_background"
    android:padding="8dp">

    <FrameLayout
        android:id="@+id/widget_target_char"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_marginBottom="6dp">
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@drawable/widget_target_choice_bg" />
        <FrameLayout
            android:id="@+id/widget_target_char_selected"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@drawable/widget_target_selected_gold"
            android:visibility="gone" />
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:text="@string/widget_target_resonator"
            android:textColor="#fef08a"
            android:textSize="13sp"
            android:textStyle="bold" />
    </FrameLayout>

    <FrameLayout
        android:id="@+id/widget_target_both"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_marginBottom="6dp">
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@drawable/widget_target_choice_bg" />
        <FrameLayout
            android:id="@+id/widget_target_both_selected"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@drawable/widget_target_selected_emerald"
            android:visibility="gone" />
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:text="@string/widget_target_both"
            android:textColor="#86efac"
            android:textSize="13sp"
            android:textStyle="bold" />
    </FrameLayout>

    <FrameLayout
        android:id="@+id/widget_target_weap"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@drawable/widget_target_choice_bg" />
        <FrameLayout
            android:id="@+id/widget_target_weap_selected"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@drawable/widget_target_selected_pink"
            android:visibility="gone" />
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:text="@string/widget_target_weapon"
            android:textColor="#fbcfe8"
            android:textSize="13sp"
            android:textStyle="bold" />
    </FrameLayout>

</LinearLayout>
