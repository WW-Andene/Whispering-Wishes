<?xml version="1.0" encoding="utf-8"?>
<!-- WidgetPullActivity — plays the rarity video (bundled locally, unlike
     convene-animations/, so a plain VideoView is fine here: no clipToOutline
     concern like FloatingBannerService used to have, since this is a normal
     fullscreen Activity, not an overlay window), then shows the pre-rendered
     result grid built by WidgetPullActivity.java. Tap anywhere to close. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/pull_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#000000"
    android:clickable="true"
    android:focusable="true">

    <VideoView
        android:id="@+id/pull_video"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_gravity="center" />

    <ScrollView
        android:id="@+id/pull_results_scroll"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:visibility="gone"
        android:padding="16dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <TextView
                android:id="@+id/pull_results_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="#FFFFFF"
                android:textSize="18sp"
                android:textStyle="bold"
                android:gravity="center"
                android:layout_marginBottom="16dp" />

            <GridLayout
                android:id="@+id/pull_results_grid"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:columnCount="5"
                android:alignmentMode="alignMargins" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:text="@string/widget_pull_disclaimer"
                android:textColor="#9CA3AF"
                android:textSize="12sp"
                android:gravity="center" />
        </LinearLayout>
    </ScrollView>

</FrameLayout>
