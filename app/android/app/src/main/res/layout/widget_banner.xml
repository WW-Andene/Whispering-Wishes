<?xml version="1.0" encoding="utf-8"?>
<!-- Home-screen "gacha banner" widget — mirrors BannerCard.jsx's layout:
     banner art as background, name/element top-left, Featured 4★ row +
     ▶️ convene-animation button bottom-right. RemoteViews only supports a
     small whitelisted set of views/attributes (no ConstraintLayout, no
     custom Views, no video) — see BannerWidget.java's file header for the
     platform limits this works within. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_background">

    <ImageView
        android:id="@+id/widget_art"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="centerCrop"
        android:contentDescription="@null" />

    <View
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/widget_banner_scrim" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="top"
        android:orientation="horizontal"
        android:padding="10dp">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/widget_banner_element"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="#FDE047"
                android:textSize="10sp"
                android:textStyle="bold"
                android:letterSpacing="0.08" />

            <TextView
                android:id="@+id/widget_banner_name"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="#FFFFFF"
                android:textSize="16sp"
                android:textStyle="bold"
                android:maxLines="1"
                android:ellipsize="end"
                android:text="@string/app_name" />
        </LinearLayout>

        <!-- ×1 / ×10 pull-simulator pills — see WidgetPullSimulator.java for
             the native probability engine and WidgetPullActivity.java for
             the rarity-video + result-screen flow they launch. Astrite icon
             (public/ui-icons/, bundled locally like the banner art) matches
             ConvenePullPills.jsx's own fallback icon in-app. -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="end">

            <LinearLayout
                android:id="@+id/widget_pull_x1"
                android:layout_width="wrap_content"
                android:layout_height="24dp"
                android:layout_marginBottom="4dp"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingStart="6dp"
                android:paddingEnd="8dp"
                android:background="@drawable/widget_pill_bg">

                <ImageView
                    android:id="@+id/widget_pull_x1_icon"
                    android:layout_width="14dp"
                    android:layout_height="14dp"
                    android:layout_marginEnd="3dp"
                    android:contentDescription="@null" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/widget_pull_x1"
                    android:textColor="#E5E7EB"
                    android:textSize="11sp" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/widget_pull_x10"
                android:layout_width="wrap_content"
                android:layout_height="24dp"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingStart="6dp"
                android:paddingEnd="8dp"
                android:background="@drawable/widget_pill_bg">

                <ImageView
                    android:id="@+id/widget_pull_x10_icon"
                    android:layout_width="14dp"
                    android:layout_height="14dp"
                    android:layout_marginEnd="3dp"
                    android:contentDescription="@null" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/widget_pull_x10"
                    android:textColor="#E5E7EB"
                    android:textSize="11sp" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:padding="8dp">

        <ImageView
            android:id="@+id/widget_f4_1"
            android:layout_width="30dp"
            android:layout_height="30dp"
            android:layout_marginEnd="4dp"
            android:scaleType="centerCrop"
            android:visibility="gone"
            android:contentDescription="@null" />

        <ImageView
            android:id="@+id/widget_f4_2"
            android:layout_width="30dp"
            android:layout_height="30dp"
            android:layout_marginEnd="4dp"
            android:scaleType="centerCrop"
            android:visibility="gone"
            android:contentDescription="@null" />

        <ImageView
            android:id="@+id/widget_f4_3"
            android:layout_width="30dp"
            android:layout_height="30dp"
            android:layout_marginEnd="4dp"
            android:scaleType="centerCrop"
            android:visibility="gone"
            android:contentDescription="@null" />

        <View
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="1" />

        <ImageButton
            android:id="@+id/widget_play"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:background="@android:color/transparent"
            android:src="@drawable/ic_play_widget"
            android:scaleType="fitCenter"
            android:visibility="gone"
            android:contentDescription="@string/banner_widget_play_aria" />
    </LinearLayout>
</FrameLayout>
