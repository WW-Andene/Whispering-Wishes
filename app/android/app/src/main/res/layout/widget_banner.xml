<?xml version="1.0" encoding="utf-8"?>
<!-- Home-screen "gacha banner" widget — mirrors BannerCard.jsx's layout:
     banner art as background, name/element top-left, Featured 4★ row +
     ▶️ convene-animation button bottom-right, a bubble on/off toggle top-
     right on the primary block (see widget_bubble_toggle below — replaces
     the old ×1/×10 pull-sim pills; pulling now happens via PullBubbleService's
     persistent floating bubble, not this widget directly). RemoteViews only supports a small
     whitelisted set of views/attributes (no ConstraintLayout, no custom
     Views, no video) — see PulseBannerWidget.java's file header for the
     platform limits this works within.

     Two stacked blocks, not one: widget_secondary_block mirrors
     widget_primary_block (same structure, "_secondary"-suffixed ids, no
     pull pills/gear) and is hidden by default — PulseBannerWidget.java's
     onAppWidgetOptionsChanged shows it once the widget is resized tall
     enough to fit both, displaying whichever banner category ISN'T the
     one configured as primary (BannerWidgetConfigureActivity.java).

     No plain <View> anywhere in this file (even as a scrim overlay or a
     weighted spacer) — RemoteViews' own supported-class allowlist is
     FrameLayout/LinearLayout/RelativeLayout/GridLayout for layouts and a
     fixed set of leaf widgets (ImageView, TextView, Button, etc.); plain
     android.view.View is NOT on that list. Inflating a layout containing
     one throws in the LAUNCHER's process (not this app's), which is what
     actually produces Android's generic "Couldn't load this widget"
     placeholder — and since PulseBannerWidget.java's own crash-fallback
     RemoteViews reuses this same layout resource, that safety net can't
     rescue a structural inflation failure like this one either. Scrim
     overlays use FrameLayout (a supported layout class) with the
     background attribute instead of a bare View; spacers use TextView
     with empty text (a supported leaf widget, invisible at zero content). -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@drawable/widget_background">

    <FrameLayout
        android:id="@+id/widget_primary_block"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <ImageView
            android:id="@+id/widget_art"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scaleType="centerCrop"
            android:contentDescription="@null" />

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@drawable/widget_banner_scrim" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="top"
            android:orientation="horizontal"
            android:padding="10dp">

            <ImageButton
                android:id="@+id/widget_settings"
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:layout_marginEnd="6dp"
                android:background="@android:color/transparent"
                android:src="@android:drawable/ic_menu_preferences"
                android:scaleType="fitCenter"
                android:alpha="0.7"
                android:contentDescription="@string/widget_configure_title" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/widget_banner_element"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="#FDE047"
                    android:textSize="10sp"
                    android:textStyle="bold"
                    android:letterSpacing="0.08" />

                <TextView
                    android:id="@+id/widget_banner_name"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="#FFFFFF"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:maxLines="1"
                    android:ellipsize="end"
                    android:text="@string/app_name" />
            </LinearLayout>

            <!-- Single toggle for PullBubbleService's persistent floating bubble — replaces
                 the old ×1/×10 pull-sim pills entirely (see PulseBannerWidget.java's file
                 header for why: a chat-heads-style bubble is a fundamentally different,
                 always-on-screen UI, not something that fits as widget content at all).
                 Tapping starts the bubble if it isn't running, or stops/removes it if it
                 is — PulseBannerWidget.java reads PullBubbleService.isRunning() to label
                 and icon this correctly each render. Primary block only — see file header.
                 Hidden in compact (very short, e.g. 1-row) sizes — see
                 PulseBannerWidget.java's COMPACT_MAX_HEIGHT_DP. -->
            <LinearLayout
                android:id="@+id/widget_bubble_toggle"
                android:layout_width="wrap_content"
                android:layout_height="24dp"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingStart="6dp"
                android:paddingEnd="8dp"
                android:background="@drawable/widget_pill_bg">

                <ImageView
                    android:id="@+id/widget_bubble_toggle_icon"
                    android:layout_width="14dp"
                    android:layout_height="14dp"
                    android:layout_marginEnd="3dp"
                    android:contentDescription="@null" />

                <TextView
                    android:id="@+id/widget_bubble_toggle_label"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="#E5E7EB"
                    android:textSize="11sp" />
            </LinearLayout>
        </LinearLayout>

        <!-- Featured-4★ row + ▶️ — hidden in compact (very short) sizes,
             same threshold as widget_bubble_toggle above. -->
        <LinearLayout
            android:id="@+id/widget_bottom_row"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:padding="8dp">

            <ImageView
                android:id="@+id/widget_f4_1"
                android:layout_width="30dp"
                android:layout_height="30dp"
                android:layout_marginEnd="4dp"
                android:scaleType="centerCrop"
                android:visibility="gone"
                android:contentDescription="@null" />

            <ImageView
                android:id="@+id/widget_f4_2"
                android:layout_width="30dp"
                android:layout_height="30dp"
                android:layout_marginEnd="4dp"
                android:scaleType="centerCrop"
                android:visibility="gone"
                android:contentDescription="@null" />

            <ImageView
                android:id="@+id/widget_f4_3"
                android:layout_width="30dp"
                android:layout_height="30dp"
                android:layout_marginEnd="4dp"
                android:scaleType="centerCrop"
                android:visibility="gone"
                android:contentDescription="@null" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1"
                android:text="" />

            <ImageButton
                android:id="@+id/widget_play"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:background="@android:color/transparent"
                android:src="@drawable/ic_play_widget"
                android:scaleType="fitCenter"
                android:visibility="gone"
                android:contentDescription="@string/banner_widget_play_aria" />
        </LinearLayout>
    </FrameLayout>

    <FrameLayout
        android:id="@+id/widget_secondary_block"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:visibility="gone">

        <ImageView
            android:id="@+id/widget_secondary_art"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scaleType="centerCrop"
            android:contentDescription="@null" />

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@drawable/widget_banner_scrim" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="top"
            android:orientation="vertical"
            android:padding="10dp">

            <TextView
                android:id="@+id/widget_secondary_element"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="#FDE047"
                android:textSize="10sp"
                android:textStyle="bold"
                android:letterSpacing="0.08" />

            <TextView
                android:id="@+id/widget_secondary_name"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="#FFFFFF"
                android:textSize="16sp"
                android:textStyle="bold"
                android:maxLines="1"
                android:ellipsize="end" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:padding="8dp">

            <ImageView
                android:id="@+id/widget_secondary_f4_1"
                android:layout_width="30dp"
                android:layout_height="30dp"
                android:layout_marginEnd="4dp"
                android:scaleType="centerCrop"
                android:visibility="gone"
                android:contentDescription="@null" />

            <ImageView
                android:id="@+id/widget_secondary_f4_2"
                android:layout_width="30dp"
                android:layout_height="30dp"
                android:layout_marginEnd="4dp"
                android:scaleType="centerCrop"
                android:visibility="gone"
                android:contentDescription="@null" />

            <ImageView
                android:id="@+id/widget_secondary_f4_3"
                android:layout_width="30dp"
                android:layout_height="30dp"
                android:layout_marginEnd="4dp"
                android:scaleType="centerCrop"
                android:visibility="gone"
                android:contentDescription="@null" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1"
                android:text="" />

            <ImageButton
                android:id="@+id/widget_secondary_play"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:background="@android:color/transparent"
                android:src="@drawable/ic_play_widget"
                android:scaleType="fitCenter"
                android:visibility="gone"
                android:contentDescription="@string/banner_widget_play_aria" />
        </LinearLayout>
    </FrameLayout>

</LinearLayout>
