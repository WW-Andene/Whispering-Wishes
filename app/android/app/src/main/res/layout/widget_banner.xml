<?xml version="1.0" encoding="utf-8"?>
<!-- Home-screen "gacha banner" widget — mirrors BannerCard.jsx's layout:
     banner art as background, name/element top-left, Featured 4★ row +
     ▶️ convene-animation button bottom-right, ×1/×10 pull-sim pills top-
     right on the primary block. RemoteViews only supports a small
     whitelisted set of views/attributes (no ConstraintLayout, no custom
     Views, no video) — see PulseBannerWidget.java's file header for the
     platform limits this works within.

     Two stacked blocks, not one: widget_secondary_block mirrors
     widget_primary_block (same structure, "_secondary"-suffixed ids, no
     pull pills/gear) and is hidden by default — PulseBannerWidget.java's
     onAppWidgetOptionsChanged shows it once the widget is resized tall
     enough to fit both, displaying whichever banner category ISN'T the
     one configured as primary (BannerWidgetConfigureActivity.java).

     No plain <View> anywhere in this file (even as a scrim overlay or a
     weighted spacer) — RemoteViews' own supported-class allowlist is
     FrameLayout/LinearLayout/RelativeLayout/GridLayout for layouts and a
     fixed set of leaf widgets (ImageView, TextView, Button, etc.); plain
     android.view.View is NOT on that list. Inflating a layout containing
     one throws in the LAUNCHER's process (not this app's), which is what
     actually produces Android's generic "Couldn't load this widget"
     placeholder — and since PulseBannerWidget.java's own crash-fallback
     RemoteViews reuses this same layout resource, that safety net can't
     rescue a structural inflation failure like this one either. Scrim
     overlays use FrameLayout (a supported layout class) with the
     background attribute instead of a bare View; spacers use TextView
     with empty text (a supported leaf widget, invisible at zero content). -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@drawable/widget_background">

    <FrameLayout
        android:id="@+id/widget_primary_block"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <ImageView
            android:id="@+id/widget_art"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scaleType="centerCrop"
            android:contentDescription="@null" />

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@drawable/widget_banner_scrim" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="top"
            android:orientation="horizontal"
            android:padding="10dp">

            <ImageButton
                android:id="@+id/widget_settings"
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:layout_marginEnd="6dp"
                android:background="@android:color/transparent"
                android:src="@android:drawable/ic_menu_preferences"
                android:scaleType="fitCenter"
                android:alpha="0.7"
                android:contentDescription="@string/widget_configure_title" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/widget_banner_element"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="#FDE047"
                    android:textSize="10sp"
                    android:textStyle="bold"
                    android:letterSpacing="0.08" />

                <TextView
                    android:id="@+id/widget_banner_name"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="#FFFFFF"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:maxLines="1"
                    android:ellipsize="end"
                    android:text="@string/app_name" />
            </LinearLayout>

            <!-- ×1 / ×10 pull-simulator pills — see WidgetPullSimulator.java
                 for the native probability engine and WidgetPullActivity.java
                 for the rarity-video + result-screen flow they launch.
                 Astrite icon (public/ui-icons/, bundled locally like the
                 banner art) matches ConvenePullPills.jsx's own fallback
                 icon in-app. Primary block only — see file header.
                 Hidden in compact (very short, e.g. 1-row) sizes — see
                 PulseBannerWidget.java's COMPACT_MAX_HEIGHT_DP. -->
            <LinearLayout
                android:id="@+id/widget_pull_pills"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:gravity="end">

                <LinearLayout
                    android:id="@+id/widget_pull_x1"
                    android:layout_width="wrap_content"
                    android:layout_height="24dp"
                    android:layout_marginBottom="4dp"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:paddingStart="6dp"
                    android:paddingEnd="8dp"
                    android:background="@drawable/widget_pill_bg">

                    <ImageView
                        android:id="@+id/widget_pull_x1_icon"
                        android:layout_width="14dp"
                        android:layout_height="14dp"
                        android:layout_marginEnd="3dp"
                        android:contentDescription="@null" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/widget_pull_x1"
                        android:textColor="#E5E7EB"
                        android:textSize="11sp" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/widget_pull_x10"
                    android:layout_width="wrap_content"
                    android:layout_height="24dp"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:paddingStart="6dp"
                    android:paddingEnd="8dp"
                    android:background="@drawable/widget_pill_bg">

                    <ImageView
                        android:id="@+id/widget_pull_x10_icon"
                        android:layout_width="14dp"
                        android:layout_height="14dp"
                        android:layout_marginEnd="3dp"
                        android:contentDescription="@null" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/widget_pull_x10"
                        android:textColor="#E5E7EB"
                        android:textSize="11sp" />
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>

        <!-- Featured-4★ row + ▶️ — hidden in compact (very short) sizes,
             same threshold as widget_pull_pills above. -->
        <LinearLayout
            android:id="@+id/widget_bottom_row"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:padding="8dp">

            <ImageView
                android:id="@+id/widget_f4_1"
                android:layout_width="30dp"
                android:layout_height="30dp"
                android:layout_marginEnd="4dp"
                android:scaleType="centerCrop"
                android:visibility="gone"
                android:contentDescription="@null" />

            <ImageView
                android:id="@+id/widget_f4_2"
                android:layout_width="30dp"
                android:layout_height="30dp"
                android:layout_marginEnd="4dp"
                android:scaleType="centerCrop"
                android:visibility="gone"
                android:contentDescription="@null" />

            <ImageView
                android:id="@+id/widget_f4_3"
                android:layout_width="30dp"
                android:layout_height="30dp"
                android:layout_marginEnd="4dp"
                android:scaleType="centerCrop"
                android:visibility="gone"
                android:contentDescription="@null" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1"
                android:text="" />

            <ImageButton
                android:id="@+id/widget_play"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:background="@android:color/transparent"
                android:src="@drawable/ic_play_widget"
                android:scaleType="fitCenter"
                android:visibility="gone"
                android:contentDescription="@string/banner_widget_play_aria" />
        </LinearLayout>

        <!-- Pull-results summary — shown only during WidgetPullPlaybackService's results
             phase (art/name/pills/bottom row all still present underneath, but this list's
             own opaque background fully covers them while visible). ListView is one of
             RemoteViews' actually-supported leaf widgets for a VARIABLE-length list (unlike
             a GridLayout, which doesn't flex cleanly to an arbitrary ×1/×10 pull count here)
             — content comes from PullResultsRemoteViewsService, one small colored-by-rarity
             name pill per pulled item (widget_pull_pill_item.xml), wrapped naturally
             regardless of whether there are 1 or 10. -->
        <ListView
            android:id="@+id/widget_pull_results_list"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="#E6141824"
            android:divider="@null"
            android:scrollbars="none"
            android:padding="8dp"
            android:visibility="gone" />
    </FrameLayout>

    <FrameLayout
        android:id="@+id/widget_secondary_block"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:visibility="gone">

        <ImageView
            android:id="@+id/widget_secondary_art"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scaleType="centerCrop"
            android:contentDescription="@null" />

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@drawable/widget_banner_scrim" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="top"
            android:orientation="vertical"
            android:padding="10dp">

            <TextView
                android:id="@+id/widget_secondary_element"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="#FDE047"
                android:textSize="10sp"
                android:textStyle="bold"
                android:letterSpacing="0.08" />

            <TextView
                android:id="@+id/widget_secondary_name"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="#FFFFFF"
                android:textSize="16sp"
                android:textStyle="bold"
                android:maxLines="1"
                android:ellipsize="end" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:padding="8dp">

            <ImageView
                android:id="@+id/widget_secondary_f4_1"
                android:layout_width="30dp"
                android:layout_height="30dp"
                android:layout_marginEnd="4dp"
                android:scaleType="centerCrop"
                android:visibility="gone"
                android:contentDescription="@null" />

            <ImageView
                android:id="@+id/widget_secondary_f4_2"
                android:layout_width="30dp"
                android:layout_height="30dp"
                android:layout_marginEnd="4dp"
                android:scaleType="centerCrop"
                android:visibility="gone"
                android:contentDescription="@null" />

            <ImageView
                android:id="@+id/widget_secondary_f4_3"
                android:layout_width="30dp"
                android:layout_height="30dp"
                android:layout_marginEnd="4dp"
                android:scaleType="centerCrop"
                android:visibility="gone"
                android:contentDescription="@null" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1"
                android:text="" />

            <ImageButton
                android:id="@+id/widget_secondary_play"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:background="@android:color/transparent"
                android:src="@drawable/ic_play_widget"
                android:scaleType="fitCenter"
                android:visibility="gone"
                android:contentDescription="@string/banner_widget_play_aria" />
        </LinearLayout>
    </FrameLayout>

</LinearLayout>
