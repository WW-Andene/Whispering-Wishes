<?xml version="1.0" encoding="utf-8"?>
<!-- Home-screen "Calculator" widget — ONE widget, ONE AppWidgetProvider
     (CalculatorWidget.java), that reveals more of itself as the user resizes it bigger,
     rather than five separate widgets the user would have to place one at a time. Two
     independent resize axes:
       WIDTH (2-5 cells) — how many of the 5 currency columns show in the always-visible
       top row (Astrite/Lunite always shown, Radiant/Lustrous/Forging Tide reveal one at
       a time as it widens).
       HEIGHT (1-5 cells) — how many of the 5 stacked sections below show at all:
         1 cell:  currency log only (row_currency)
         2 cells: + a single gauge toward the chosen goal (row_progress)
         3 cells: + pull target picker: Resonator/Both/Weapon (row_target)
         4 cells: + pity counter + tappable copy target (row_pity)
         5 cells: + probability/statistics (row_stats — not yet implemented, stays empty)
     CalculatorWidget.onAppWidgetOptionsChanged reads both axes and toggles visibility
     accordingly; each visible row shares the available height evenly (layout_weight).

     Background is the "Log 2.0" banner art (widget_bg_art), with a uniform darkening scrim
     baked into that SAME bitmap in CalculatorWidget.java
     (WidgetAssetUtils.roundedCornersWithUniformScrim) rather than layered on top as its own
     square FrameLayout — a separate square, near-opaque overlay drawn OVER an
     already-rounded art bitmap paints right back over its rounded corners (see
     WidgetAssetUtils.roundedCornersWithScrim's own comment on this exact failure mode,
     which PulseBannerWidget.java's banner art avoids the same way). Unlike that widget's
     bottom-weighted gradient scrim, this one is uniform — this widget's rows span the full
     height, not just one edge. widget_background stays as the root's own drawable so a
     failed art decode still shows the app's normal dark rounded card.

     No plain <View> anywhere (RemoteViews' allowlist doesn't include it — see
     widget_banner.xml's own comment on this) — background layers use empty FrameLayouts
     instead. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_background">

    <!-- fitXY, not centerCrop — CalculatorWidget.java's WidgetAssetUtils.decodeAssetExactCrop
         already crops/scales this bitmap to this exact view's own pixel size before rounding
         its corners; centerCrop scaling it a SECOND time here would cut back through those
         rounded corner arcs on this widget's own wide/short aspect ratios. See
         decodeAssetExactCrop's own comment. -->
    <ImageView
        android:id="@+id/widget_bg_art"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="fitXY"
        android:contentDescription="@null" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:padding="8dp">

        <!-- ═══ Row 1 — Currency log (always visible; column count driven by WIDTH) ═══ -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:orientation="horizontal">

            <LinearLayout android:id="@+id/widget_currency_row_astrite" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:orientation="horizontal" android:gravity="center">
                <ImageView android:id="@+id/widget_currency_icon_astrite" android:layout_width="32dp" android:layout_height="32dp" android:contentDescription="@null" />
                <TextView android:id="@+id/widget_currency_value_astrite" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginLeft="6dp" android:textColor="#facc15" android:textSize="16sp" android:textStyle="bold" android:singleLine="true" />
            </LinearLayout>
            <LinearLayout android:id="@+id/widget_currency_row_lunite" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:orientation="horizontal" android:gravity="center">
                <ImageView android:id="@+id/widget_currency_icon_lunite" android:layout_width="32dp" android:layout_height="32dp" android:contentDescription="@null" />
                <TextView android:id="@+id/widget_currency_value_lunite" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginLeft="6dp" android:textColor="#67e8f9" android:textSize="16sp" android:textStyle="bold" android:singleLine="true" />
            </LinearLayout>
            <LinearLayout android:id="@+id/widget_currency_row_radiant" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:orientation="horizontal" android:gravity="center" android:visibility="gone">
                <ImageView android:id="@+id/widget_currency_icon_radiant" android:layout_width="32dp" android:layout_height="32dp" android:contentDescription="@null" />
                <TextView android:id="@+id/widget_currency_value_radiant" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginLeft="6dp" android:textColor="#fde047" android:textSize="16sp" android:textStyle="bold" android:singleLine="true" />
            </LinearLayout>
            <LinearLayout android:id="@+id/widget_currency_row_lustrous" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:orientation="horizontal" android:gravity="center" android:visibility="gone">
                <ImageView android:id="@+id/widget_currency_icon_lustrous" android:layout_width="32dp" android:layout_height="32dp" android:contentDescription="@null" />
                <TextView android:id="@+id/widget_currency_value_lustrous" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginLeft="6dp" android:textColor="#22d3ee" android:textSize="16sp" android:textStyle="bold" android:singleLine="true" />
            </LinearLayout>
            <LinearLayout android:id="@+id/widget_currency_row_forging" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:orientation="horizontal" android:gravity="center" android:visibility="gone">
                <ImageView android:id="@+id/widget_currency_icon_forging" android:layout_width="32dp" android:layout_height="32dp" android:contentDescription="@null" />
                <TextView android:id="@+id/widget_currency_value_forging" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginLeft="6dp" android:textColor="#f9a8d4" android:textSize="16sp" android:textStyle="bold" android:singleLine="true" />
            </LinearLayout>
        </LinearLayout>

        <!-- ═══ Row 2 — ONE gauge toward the currently chosen goal (revealed at height >= 2 cells) ═══
             Single bar, not one per currency: total owned resources vs. total needed,
             both expressed in "pulls toward the selected target" — see
             CalculatorWidget.renderProgressSection for the conversion. -->
        <LinearLayout
            android:id="@+id/widget_section_progress"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center"
            android:visibility="gone">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">
                <ImageView android:id="@+id/widget_progress_icon" android:layout_width="32dp" android:layout_height="32dp" android:contentDescription="@null" />
                <TextView android:id="@+id/widget_progress_value" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:layout_marginLeft="6dp" android:textColor="#e4e7ee" android:textSize="16sp" android:textStyle="bold" android:singleLine="true" />
            </LinearLayout>
            <ProgressBar android:id="@+id/widget_progress_bar" style="?android:attr/progressBarStyleHorizontal" android:layout_width="match_parent" android:layout_height="12dp" android:layout_marginTop="4dp" android:max="100" android:progress="0" />
        </LinearLayout>

        <!-- ═══ Row 3 — Pull target picker (revealed at height >= 3 cells) ═══ -->
        <LinearLayout
            android:id="@+id/widget_section_target"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:orientation="horizontal"
            android:visibility="gone">

            <FrameLayout android:id="@+id/widget_target_char" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:layout_marginRight="6dp">
                <FrameLayout android:layout_width="match_parent" android:layout_height="match_parent" android:background="@drawable/widget_target_choice_bg" />
                <FrameLayout android:id="@+id/widget_target_char_selected" android:layout_width="match_parent" android:layout_height="match_parent" android:background="@drawable/widget_target_selected_gold" android:visibility="gone" />
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_gravity="center" android:text="@string/widget_target_resonator" android:textColor="#fef08a" android:textSize="16sp" android:textStyle="bold" />
            </FrameLayout>
            <FrameLayout android:id="@+id/widget_target_both" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:layout_marginRight="6dp">
                <FrameLayout android:layout_width="match_parent" android:layout_height="match_parent" android:background="@drawable/widget_target_choice_bg" />
                <FrameLayout android:id="@+id/widget_target_both_selected" android:layout_width="match_parent" android:layout_height="match_parent" android:background="@drawable/widget_target_selected_emerald" android:visibility="gone" />
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_gravity="center" android:text="@string/widget_target_both" android:textColor="#86efac" android:textSize="16sp" android:textStyle="bold" />
            </FrameLayout>
            <FrameLayout android:id="@+id/widget_target_weap" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1">
                <FrameLayout android:layout_width="match_parent" android:layout_height="match_parent" android:background="@drawable/widget_target_choice_bg" />
                <FrameLayout android:id="@+id/widget_target_weap_selected" android:layout_width="match_parent" android:layout_height="match_parent" android:background="@drawable/widget_target_selected_pink" android:visibility="gone" />
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_gravity="center" android:text="@string/widget_target_weapon" android:textColor="#fbcfe8" android:textSize="16sp" android:textStyle="bold" />
            </FrameLayout>
        </LinearLayout>

        <!-- ═══ Row 4 — Pity counter + tappable copy target (revealed at height >= 4 cells) ═══
             No pity-count fraction here any more (used to show "X / 80" under each label) —
             just the label and a tappable copy-target pill; tapping cycles it forward
             (1..7 for Resonator, 1..5 for Weapon, wrapping back to 1) via
             CalculatorWidget's ACTION_CYCLE_COPIES broadcast. -->
        <LinearLayout
            android:id="@+id/widget_section_pity"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:orientation="horizontal"
            android:visibility="gone">

            <LinearLayout android:id="@+id/widget_pity_block_char" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:orientation="vertical" android:gravity="center">
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/widget_target_resonator" android:textColor="#8892a4" android:textSize="16sp" android:textStyle="bold" android:letterSpacing="0.08" />
                <FrameLayout android:id="@+id/widget_pity_copies_char" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:background="@drawable/widget_target_choice_bg" android:padding="6dp">
                    <TextView android:id="@+id/widget_pity_copies_char_text" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textColor="#fef08a" android:textSize="16sp" android:textStyle="bold" />
                </FrameLayout>
            </LinearLayout>
            <LinearLayout android:id="@+id/widget_pity_block_weap" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:orientation="vertical" android:gravity="center">
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/widget_target_weapon" android:textColor="#8892a4" android:textSize="16sp" android:textStyle="bold" android:letterSpacing="0.08" />
                <FrameLayout android:id="@+id/widget_pity_copies_weap" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:background="@drawable/widget_target_choice_bg" android:padding="6dp">
                    <TextView android:id="@+id/widget_pity_copies_weap_text" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textColor="#fbcfe8" android:textSize="16sp" android:textStyle="bold" />
                </FrameLayout>
            </LinearLayout>
        </LinearLayout>

        <!-- ═══ Row 5 — Probability/statistics (revealed at height = 5 cells) ═══ -->
        <!-- Not yet implemented — CalculatorWidget.java leaves this hidden and empty until
             that mode is built; the row exists now so the height threshold and layout slot
             are already in place. -->
        <LinearLayout
            android:id="@+id/widget_section_stats"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:orientation="horizontal"
            android:visibility="gone">
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:gravity="center"
                android:text="@string/widget_stats_placeholder"
                android:textColor="#5b6478"
                android:textSize="16sp" />
        </LinearLayout>

    </LinearLayout>
</FrameLayout>
