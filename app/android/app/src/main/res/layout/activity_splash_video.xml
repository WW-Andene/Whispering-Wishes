<?xml version="1.0" encoding="utf-8"?>
<!-- Native boot splash — plays one of the two Boot_Intro clips via a plain
     VideoView, entirely outside the WebView/Capacitor bridge, so the video
     decode never competes with the WebView's own cold start for CPU. See
     SplashVideoActivity.java for the full handoff logic. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/app_background">

    <VideoView
        android:id="@+id/splashVideoView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_gravity="center" />

</FrameLayout>
