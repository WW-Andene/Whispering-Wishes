<?xml version="1.0" encoding="utf-8"?>
<!-- One row of the pull-results list (PullResultsRemoteViewsService) — a single
     small pill: name text tinted by rarity (gold=5★, purple=4★, cyan=3★, matching
     WidgetPullActivity's own rarityColor() convention) on the same translucent
     capsule background the ×1/×10 buttons use. Deliberately just one TextView —
     the "pill" IS the view, not a container around a separate label. -->
<TextView xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/pull_pill_name"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:layout_margin="4dp"
    android:paddingStart="10dp"
    android:paddingEnd="10dp"
    android:paddingTop="5dp"
    android:paddingBottom="5dp"
    android:background="@drawable/widget_pill_bg"
    android:textSize="12sp"
    android:textStyle="bold"
    android:maxLines="1"
    android:ellipsize="end" />
