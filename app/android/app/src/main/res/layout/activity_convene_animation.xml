<?xml version="1.0" encoding="utf-8"?>
<!-- Full-screen convene-animation player launched from GachaBannerWidget.java's
     ▶️ button — a real Activity, unlike the widget itself, so VideoView
     (unsupported in RemoteViews) can actually play here. Tapping anywhere
     skips/closes, same as the app's own convene video preview. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/convene_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#000000"
    android:clickable="true"
    android:focusable="true">

    <VideoView
        android:id="@+id/convene_video"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_gravity="center" />

</FrameLayout>
