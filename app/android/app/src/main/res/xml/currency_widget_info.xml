<?xml version="1.0" encoding="utf-8"?>
<!-- 1 cell tall, resizable in WIDTH only from 2 to 5 cells (see CurrencyWidget.java's
     REVEAL_COL3/4/5_DP thresholds, which are this same 70dp*cells-30dp grid formula).
     minHeight/minResizeHeight pinned to the same 1-cell floor since this widget's whole
     premise is a single short currency strip — height resizing isn't part of the design
     (resizeMode="horizontal" only). -->
<appwidget-provider xmlns:android="http://schemas.android.com/apk/res/android"
    android:minWidth="110dp"
    android:minHeight="40dp"
    android:minResizeWidth="110dp"
    android:minResizeHeight="40dp"
    android:maxResizeWidth="320dp"
    android:targetCellWidth="2"
    android:targetCellHeight="1"
    android:updatePeriodMillis="1800000"
    android:previewImage="@mipmap/ic_launcher"
    android:initialLayout="@layout/widget_currency"
    android:resizeMode="horizontal"
    android:widgetCategory="home_screen"
    android:description="@string/currency_widget_description">
</appwidget-provider>
