<?xml version="1.0" encoding="utf-8"?>
<!-- Fixed 3 cells tall x 5 cells wide (180dp x 320dp, same 70dp*cells-30dp grid formula
     as every other widget in this app) — resizeMode="none" since, unlike mode 1, there's
     no meaningful smaller/larger layout for three big tappable choices to grow or shrink
     into; the size itself is the design. -->
<appwidget-provider xmlns:android="http://schemas.android.com/apk/res/android"
    android:minWidth="320dp"
    android:minHeight="180dp"
    android:targetCellWidth="5"
    android:targetCellHeight="3"
    android:updatePeriodMillis="1800000"
    android:previewImage="@mipmap/ic_launcher"
    android:initialLayout="@layout/widget_target"
    android:resizeMode="none"
    android:widgetCategory="home_screen"
    android:description="@string/target_widget_description">
</appwidget-provider>
