<?xml version="1.0" encoding="utf-8"?>
<!-- Fixed 4x5 cells (250dp x 320dp, same 70dp*cells-30dp grid formula as every other
     widget in this app) — resizeMode="none", same reasoning as target_widget_info.xml
     (mode 3): this is a status readout, not something with a meaningful smaller/larger
     layout to grow or shrink into. -->
<appwidget-provider xmlns:android="http://schemas.android.com/apk/res/android"
    android:minWidth="250dp"
    android:minHeight="320dp"
    android:targetCellWidth="4"
    android:targetCellHeight="5"
    android:updatePeriodMillis="1800000"
    android:previewImage="@mipmap/ic_launcher"
    android:initialLayout="@layout/widget_pity_target"
    android:resizeMode="none"
    android:widgetCategory="home_screen"
    android:description="@string/pity_target_widget_description">
</appwidget-provider>
