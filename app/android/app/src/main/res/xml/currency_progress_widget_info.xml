<?xml version="1.0" encoding="utf-8"?>
<!-- Fixed 2 cells tall x 5 cells wide (110dp x 320dp, same 70dp*cells-30dp grid formula
     as every other widget in this app), NOT resizable — same H x W, fixed-size convention
     as modes 1/3/4 (mode 1's own resizable width is the one exception, since it has an
     explicit range in its spec). All five currencies render as columns at once; there's
     no smaller/larger layout for this one to grow or shrink into. -->
<appwidget-provider xmlns:android="http://schemas.android.com/apk/res/android"
    android:minWidth="320dp"
    android:minHeight="110dp"
    android:targetCellWidth="5"
    android:targetCellHeight="2"
    android:updatePeriodMillis="1800000"
    android:previewImage="@mipmap/ic_launcher"
    android:initialLayout="@layout/widget_currency_progress"
    android:resizeMode="none"
    android:widgetCategory="home_screen"
    android:description="@string/currency_progress_widget_description">
</appwidget-provider>
