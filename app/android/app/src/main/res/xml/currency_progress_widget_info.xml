<?xml version="1.0" encoding="utf-8"?>
<!-- 2 cells wide (icon + value text + a readable progress bar need more room than mode
     1's single narrow column), resizable in height only from 2 to 5 cells — same grid
     math and reveal thresholds as currency_widget_info.xml (mode 1). -->
<appwidget-provider xmlns:android="http://schemas.android.com/apk/res/android"
    android:minWidth="110dp"
    android:minHeight="110dp"
    android:minResizeWidth="110dp"
    android:minResizeHeight="110dp"
    android:maxResizeHeight="320dp"
    android:targetCellWidth="2"
    android:targetCellHeight="2"
    android:updatePeriodMillis="1800000"
    android:previewImage="@mipmap/ic_launcher"
    android:initialLayout="@layout/widget_currency_progress"
    android:resizeMode="vertical"
    android:widgetCategory="home_screen"
    android:description="@string/currency_progress_widget_description">
</appwidget-provider>
