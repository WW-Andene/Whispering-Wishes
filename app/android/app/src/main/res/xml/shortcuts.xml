<?xml version="1.0" encoding="utf-8"?>
<!-- Home-screen long-press App Shortcuts. Both use @mipmap/ic_launcher_round rather than
     @mipmap/ic_launcher — a static XML-declared shortcut's icon isn't reliably re-masked
     into the launcher's own adaptive shape the way a dynamic ShortcutManager icon is on
     every launcher, so pointing at the launcher's own SQUARE mipmap left these rendering
     with visibly square corners in the long-press menu; ic_launcher_round is the
     pre-clipped circular variant Android Studio's icon tooling already generates
     alongside it, and needs no new art. -->
<shortcuts xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Toggles the floating pull bubble on/off via PullBubbleShortcutActivity's trampoline,
         without needing to open the app or find PulseBannerWidget's own toggle button first. -->
    <shortcut
        android:shortcutId="toggle_pull_bubble"
        android:enabled="true"
        android:icon="@mipmap/ic_launcher_round"
        android:shortcutShortLabel="@string/pull_bubble_shortcut_short_label"
        android:shortcutLongLabel="@string/pull_bubble_shortcut_long_label">
        <intent
            android:action="android.intent.action.VIEW"
            android:targetPackage="cc.andene.whisperingwishes"
            android:targetClass="cc.andene.whisperingwishes.PullBubbleShortcutActivity" />
    </shortcut>

    <!-- Triggers Android's own "pin to home screen" flow for CalculatorWidget via
         QuickCalcShortcutActivity's trampoline — NOT a shortcut into the app's own
         Calculator tab, it puts the actual home-screen widget on the user's home screen
         directly, without them having to find it in the system widget picker themselves. -->
    <shortcut
        android:shortcutId="quick_calc"
        android:enabled="true"
        android:icon="@mipmap/ic_launcher_round"
        android:shortcutShortLabel="@string/quick_calc_shortcut_short_label"
        android:shortcutLongLabel="@string/quick_calc_shortcut_long_label">
        <intent
            android:action="android.intent.action.VIEW"
            android:targetPackage="cc.andene.whisperingwishes"
            android:targetClass="cc.andene.whisperingwishes.QuickCalcShortcutActivity" />
    </shortcut>
</shortcuts>
