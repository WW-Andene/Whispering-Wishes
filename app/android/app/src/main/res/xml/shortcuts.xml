<?xml version="1.0" encoding="utf-8"?>
<!-- Home-screen long-press App Shortcuts. Quick Calc keeps @mipmap/ic_launcher_round (no
     distinct art of its own); the other two use per-shortcut mipmap sets
     (ic_shortcut_pocket_convene, ic_shortcut_cassette) generated directly from the app's
     existing Radiant Tide header emblem (app-title-icon/WW-Radiant-Tide.png.png) and the
     Frequency Cassette widget's own product photo (widgets/cassette-widget.png) — plain
     uniform-scaled resize into each density bucket, no crop/mask/effects, so the launcher's
     long-press menu shows the actual icon rather than the generic app icon for these two. -->
<shortcuts xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Toggles the floating pull bubble on/off via PullBubbleShortcutActivity's trampoline,
         without needing to open the app or find PulseBannerWidget's own toggle button first. -->
    <shortcut
        android:shortcutId="toggle_pull_bubble"
        android:enabled="true"
        android:icon="@mipmap/ic_shortcut_pocket_convene"
        android:shortcutShortLabel="@string/pull_bubble_shortcut_short_label"
        android:shortcutLongLabel="@string/pull_bubble_shortcut_long_label">
        <intent
            android:action="android.intent.action.VIEW"
            android:targetPackage="cc.andene.whisperingwishes"
            android:targetClass="cc.andene.whisperingwishes.PullBubbleShortcutActivity" />
    </shortcut>

    <!-- Triggers Android's own "pin to home screen" flow for CalculatorWidget via
         QuickCalcShortcutActivity's trampoline — NOT a shortcut into the app's own
         Calculator tab, it puts the actual home-screen widget on the user's home screen
         directly, without them having to find it in the system widget picker themselves. -->
    <shortcut
        android:shortcutId="quick_calc"
        android:enabled="true"
        android:icon="@mipmap/ic_launcher_round"
        android:shortcutShortLabel="@string/quick_calc_shortcut_short_label"
        android:shortcutLongLabel="@string/quick_calc_shortcut_long_label">
        <intent
            android:action="android.intent.action.VIEW"
            android:targetPackage="cc.andene.whisperingwishes"
            android:targetClass="cc.andene.whisperingwishes.QuickCalcShortcutActivity" />
    </shortcut>

    <!-- Same "pin to home screen" flow as Quick Calc above, for SoundtrackWidget instead —
         see QuickSoundtrackShortcutActivity's own file header. -->
    <shortcut
        android:shortcutId="quick_soundtrack"
        android:enabled="true"
        android:icon="@mipmap/ic_shortcut_cassette"
        android:shortcutShortLabel="@string/quick_soundtrack_shortcut_short_label"
        android:shortcutLongLabel="@string/quick_soundtrack_shortcut_long_label">
        <intent
            android:action="android.intent.action.VIEW"
            android:targetPackage="cc.andene.whisperingwishes"
            android:targetClass="cc.andene.whisperingwishes.QuickSoundtrackShortcutActivity" />
    </shortcut>
</shortcuts>
