<?xml version="1.0" encoding="utf-8" ?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/AppTheme">
        <activity
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|locale|smallestScreenSize|screenLayout|uiMode|navigation|density"
            android:name=".MainActivity"
            android:label="@string/title_activity_main"
            android:theme="@style/AppTheme.NoActionBarLaunch"
            android:launchMode="singleTask"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- Home-screen long-press App Shortcuts — see res/xml/shortcuts.xml and
                 PullBubbleShortcutActivity. -->
            <meta-data
                android:name="android.app.shortcuts"
                android:resource="@xml/shortcuts" />
        </activity>

        <!-- Pure trampoline target for the App Shortcut above — see its own file header.
             exported="true" is required: App Shortcuts are launched by the launcher app (a
             separate process), the same cross-app-caller reasoning as
             BannerWidgetConfigureActivity below. -->
        <activity
            android:name=".PullBubbleShortcutActivity"
            android:theme="@style/AppTheme.Trampoline"
            android:excludeFromRecents="true"
            android:exported="true" />

        <!-- Must be exported="true" — the system server (AppWidgetManager, a
             different process/app) is what sends APPWIDGET_UPDATE broadcasts
             to this receiver; that's a cross-app caller like the configure
             Activity below, not something our own app broadcasts to itself.
             With exported="false" the system's broadcasts are silently
             dropped: the widget never receives its first update, never
             renders, and never refreshes — this was very likely the real
             "doesn't work at all" root cause, more fundamental than the
             configure-Activity exported fix already applied below. -->
        <receiver
            android:name=".PulseBannerWidget"
            android:exported="true">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/banner_widget_info" />
        </receiver>

        <!-- Currency-log widget (mode 1 of the Calculator-widget series) — same
             exported="true" requirement as PulseBannerWidget above: the system's own
             APPWIDGET_UPDATE broadcast is what drives this receiver, and an
             exported="false" receiver silently drops it. -->
        <receiver
            android:name=".CurrencyWidget"
            android:exported="true">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/currency_widget_info" />
        </receiver>

        <!-- Currency-progress widget (mode 2 of the Calculator-widget series) — same
             exported="true" requirement as the other widget receivers above. -->
        <receiver
            android:name=".CurrencyProgressWidget"
            android:exported="true">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/currency_progress_widget_info" />
        </receiver>

        <!-- Pull-target widget (mode 3 of the Calculator-widget series) — same
             exported="true" requirement as the other widget receivers above; also needs
             to receive its own ACTION_SET_TARGET broadcast (TargetWidget.java's button
             taps), which has no intent-filter here since it's only ever sent explicitly
             via PendingIntent.getBroadcast() targeting this exact component, not
             broadcast system-wide. -->
        <receiver
            android:name=".TargetWidget"
            android:exported="true">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/target_widget_info" />
        </receiver>

        <activity
            android:name=".ConveneAnimationActivity"
            android:theme="@style/AppTheme.ConveneOverlay"
            android:exported="false"
            android:excludeFromRecents="true"
            android:launchMode="singleInstance"
            android:configChanges="orientation|screenSize" />

        <!-- Plays the convene animation in a small floating, rounded window over the home
             screen (real VideoView, real quality/audio) — requested explicitly in place of
             a fullscreen Activity. Needs android.permission.SYSTEM_ALERT_WINDOW (declared
             below); falls back to ConveneAnimationActivity when that isn't granted or
             overlay playback fails for any reason — see the service's own file header.
             Started via PendingIntent.getService() from PulseBannerWidget's own ▶️ buttons
             and PullBubbleService's own sub-bubbles (our own app, so exported="false" is
             correct). Deliberately a PLAIN service, not a foreground one: the whole job is
             a few seconds of playback triggered directly by a user tap, which gets
             Android's short temporary background-execution allowance regardless of
             Doze/App-Standby. -->
        <service
            android:name=".FloatingVideoOverlayService"
            android:exported="false" />

        <!-- Chat-heads-style persistent floating pull bubble — replaces PulseBannerWidget's
             old ×1/×10 pull-sim pills entirely (see PullBubbleService's own file header for
             the full roll → sub-bubbles → floating video → dismissible result-icon flow).
             UNLIKE every other Service in this file, this one is a genuine, always-on
             FOREGROUND service (declared foregroundServiceType="specialUse" — a floating
             chat-heads-style bubble doesn't cleanly fit any of Android's other standard FGS
             types — with the required PROPERTY_SPECIAL_USE_FGS_SUBTYPE justification below)
             since it stays on screen until the user drags it onto its own ✕ target, not just
             for a few seconds after a tap. Needs android.permission.SYSTEM_ALERT_WINDOW
             (shared with FloatingVideoOverlayService above) plus FOREGROUND_SERVICE and (API
             34+) FOREGROUND_SERVICE_SPECIAL_USE, both declared below. Toggled on/off via
             PendingIntent.getService() from PulseBannerWidget's bubble-toggle button
             (ACTION_TOGGLE), so exported="false" is correct — nothing outside this app ever
             starts it directly. -->
        <service
            android:name=".PullBubbleService"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="Persistent floating bubble the user explicitly enables to roll gacha pulls and play the result animation without switching apps; the user disables it by dragging it onto its own on-screen dismiss target." />
        </service>

        <!-- exported="true" is required here, unlike every other Activity in
             this file — this one is launched directly by the LAUNCHER app
             (a separate process/app, e.g. Pixel Launcher) via
             ACTION_APPWIDGET_CONFIGURE the moment the widget is placed, not
             via a PendingIntent our own app created (PendingIntents run
             with their creating app's identity regardless of exported, which
             is why ConveneAnimationActivity above (and the other plain
             Services in this file) are correctly exported="false" — they're only ever started that
             way). A cross-app Intent naming this component directly needs
             exported="true", or Android silently refuses to start it and
             the whole widget-placement flow fails — this was very likely
             why the widget "didn't work at all". -->
        <activity
            android:name=".BannerWidgetConfigureActivity"
            android:theme="@style/AppTheme.NoActionBar"
            android:exported="true">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_CONFIGURE" />
            </intent-filter>
        </activity>

        <!-- Real Android Live Wallpaper — renders a looping video onto the wallpaper surface
             via MediaPlayer (LiveVideoWallpaperService.Engine), unlike WallpaperPlugin's static
             WallpaperManager.setBitmap() which can never animate. Applied via
             WallpaperPlugin.setLiveWallpaper() firing ACTION_CHANGE_LIVE_WALLPAPER, which opens
             Android's own live-wallpaper confirmation screen naming this component — that
             system UI step is required and can't be skipped. BIND_WALLPAPER is a signature/
             system permission the OS itself holds, not something an app requests at runtime;
             declaring it here is what lets the system bind to this service as a wallpaper. -->
        <service
            android:name=".LiveVideoWallpaperService"
            android:exported="true"
            android:permission="android.permission.BIND_WALLPAPER">
            <intent-filter>
                <action android:name="android.service.wallpaper.WallpaperService" />
            </intent-filter>
            <meta-data
                android:name="android.service.wallpaper"
                android:resource="@xml/live_wallpaper" />
        </service>

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data android:name="android.support.FILE_PROVIDER_PATHS" android:resource="@xml/file_paths" />
        </provider>
    </application>

    <!-- Permissions -->

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-feature android:name="android.hardware.camera" android:required="false" />
    <!-- Without this, navigator.vibrate()/@capacitor/haptics silently do nothing in the
         WebView — unlike a browser tab, an Android app needs this permission declared. -->
    <uses-permission android:name="android.permission.VIBRATE" />
    <!-- Android 13+ (API 33) requires this runtime permission before any notification
         (including FCM push) can be shown — requested at runtime via
         PushNotifications.requestPermissions() in src/utils/pushNotifications.js. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- "Draw over other apps" — required by FloatingVideoOverlayService's floating convene-
         animation window. NOT a normal runtime prompt: the user grants this manually via a
         dedicated system settings screen (FloatingVideoOverlayService.requestOverlayPermission()
         opens it), and Google Play requires a declared justification for apps using it. Until
         granted, playback falls back to the fullscreen ConveneAnimationActivity instead. -->
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />
    <!-- Required (API 28+) to run ANY foreground service — PullBubbleService's persistent
         floating bubble. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <!-- Required (API 34+) specifically for a foregroundServiceType="specialUse" service —
         PullBubbleService, see its own manifest entry's comment for why "specialUse" rather
         than one of the other standard types. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <!-- Normal (not dangerous) permission — no runtime prompt needed, just this declaration.
         Required for WallpaperManager.setBitmap(), used by WallpaperPlugin to set a collection
         asset as the phone's home/lock screen wallpaper. -->
    <uses-permission android:name="android.permission.SET_WALLPAPER" />
</manifest>
