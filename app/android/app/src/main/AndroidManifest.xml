<?xml version="1.0" encoding="utf-8" ?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/AppTheme">
        <activity
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|locale|smallestScreenSize|screenLayout|uiMode|navigation|density"
            android:name=".MainActivity"
            android:label="@string/title_activity_main"
            android:theme="@style/AppTheme.NoActionBarLaunch"
            android:launchMode="singleTask"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Must be exported="true" — the system server (AppWidgetManager, a
             different process/app) is what sends APPWIDGET_UPDATE broadcasts
             to this receiver; that's a cross-app caller like the configure
             Activity below, not something our own app broadcasts to itself.
             With exported="false" the system's broadcasts are silently
             dropped: the widget never receives its first update, never
             renders, and never refreshes — this was very likely the real
             "doesn't work at all" root cause, more fundamental than the
             configure-Activity exported fix already applied below. -->
        <receiver
            android:name=".PulseBannerWidget"
            android:exported="true">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/banner_widget_info" />
        </receiver>

        <activity
            android:name=".ConveneAnimationActivity"
            android:theme="@style/AppTheme.ConveneOverlay"
            android:exported="false"
            android:excludeFromRecents="true"
            android:launchMode="singleInstance"
            android:configChanges="orientation|screenSize" />

        <activity
            android:name=".WidgetPullActivity"
            android:theme="@style/AppTheme.ConveneOverlay"
            android:exported="false"
            android:excludeFromRecents="true"
            android:launchMode="singleInstance"
            android:configChanges="orientation|screenSize" />

        <!-- Plays the convene animation in a small floating, rounded window over the home
             screen (real VideoView, real quality/audio) — requested explicitly in place of
             both a fullscreen Activity and a frame-decoded-bitmap trick like
             WidgetPullPlaybackService below uses for pull results. Needs
             android.permission.SYSTEM_ALERT_WINDOW (declared below); falls back to
             ConveneAnimationActivity when that isn't granted or overlay playback fails for
             any reason — see the service's own file header. Started via
             PendingIntent.getService() from PulseBannerWidget's own ▶️ buttons (our own
             app, so exported="false" is correct). Deliberately a PLAIN service, not a
             foreground one: the whole job is a few seconds of playback triggered directly
             by a user tap, which gets Android's short temporary background-execution
             allowance regardless of Doze/App-Standby — a foreground service would need a
             persistent notification and a targetSdk 34+ foregroundServiceType that doesn't
             cleanly fit this use case anyway. -->
        <service
            android:name=".FloatingVideoOverlayService"
            android:exported="false" />

        <!-- Same reasoning as FloatingVideoOverlayService above (plain, non-foreground,
             started via PendingIntent.getService() from PulseBannerWidget's ×1/×10 pills) —
             this one owns the whole native pull sequence: rarity video frames (played as
             decoded bitmap frames directly on the widget's own art slot, since — unlike
             the convene animation's floating window — this needs to render ON the widget
             itself, not in a separate window), then each pulled item's own portrait, then
             the colored-pills results summary. -->
        <service
            android:name=".WidgetPullPlaybackService"
            android:exported="false" />

        <!-- Backs widget_banner.xml's widget_pull_results_list (set via
             RemoteViews.setRemoteAdapter in WidgetPullPlaybackService). The launcher process
             binds to this to fetch row views, so android.permission.BIND_REMOTEVIEWS is
             required here specifically — without it, any app could bind arbitrary
             RemoteViewsFactory data into this app's widget. exported="true" only in the sense
             that the OS-enforced permission gates who can actually bind, the same pattern
             every RemoteViewsService on Android uses (this is NOT the same "cross-app
             component" reasoning as BannerWidgetConfigureActivity's exported="true" below). -->
        <service
            android:name=".PullResultsRemoteViewsService"
            android:permission="android.permission.BIND_REMOTEVIEWS"
            android:exported="true" />

        <!-- exported="true" is required here, unlike every other Activity in
             this file — this one is launched directly by the LAUNCHER app
             (a separate process/app, e.g. Pixel Launcher) via
             ACTION_APPWIDGET_CONFIGURE the moment the widget is placed, not
             via a PendingIntent our own app created (PendingIntents run
             with their creating app's identity regardless of exported, which
             is why ConveneAnimationActivity/WidgetPullActivity above are
             correctly exported="false" — they're only ever started that
             way). A cross-app Intent naming this component directly needs
             exported="true", or Android silently refuses to start it and
             the whole widget-placement flow fails — this was very likely
             why the widget "didn't work at all". -->
        <activity
            android:name=".BannerWidgetConfigureActivity"
            android:theme="@style/AppTheme.NoActionBar"
            android:exported="true">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_CONFIGURE" />
            </intent-filter>
        </activity>

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data android:name="android.support.FILE_PROVIDER_PATHS" android:resource="@xml/file_paths" />
        </provider>
    </application>

    <!-- Permissions -->

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-feature android:name="android.hardware.camera" android:required="false" />
    <!-- Without this, navigator.vibrate()/@capacitor/haptics silently do nothing in the
         WebView — unlike a browser tab, an Android app needs this permission declared. -->
    <uses-permission android:name="android.permission.VIBRATE" />
    <!-- Android 13+ (API 33) requires this runtime permission before any notification
         (including FCM push) can be shown — requested at runtime via
         PushNotifications.requestPermissions() in src/utils/pushNotifications.js. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- "Draw over other apps" — required by FloatingVideoOverlayService's floating convene-
         animation window. NOT a normal runtime prompt: the user grants this manually via a
         dedicated system settings screen (FloatingVideoOverlayService.requestOverlayPermission()
         opens it), and Google Play requires a declared justification for apps using it. Until
         granted, playback falls back to the fullscreen ConveneAnimationActivity instead. -->
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />
</manifest>
