# Required: Groq API key (free at https://console.groq.com/keys)
GROQ_API_KEY=gsk_...

# Optional: Override model (default: llama-3.3-70b-versatile)
# GROQ_MODEL=llama-3.3-70b-versatile

# Optional: WW-B Dashboard connection (for review UI)
# DASHBOARD_URL=https://your-dashboard-url.onrender.com
# DASHBOARD_TOKEN=your-secret-token

# Optional: Git author for WW-B commits
# GIT_AUTHOR_NAME=WW-B
# GIT_AUTHOR_EMAIL=agent@whisperingwishes.app
