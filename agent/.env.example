# Required: Anthropic API key for Claude
ANTHROPIC_API_KEY=sk-ant-...

# Optional: Override model (default: claude-sonnet-4-20250514)
# ANTHROPIC_MODEL=claude-sonnet-4-20250514

# Optional: Git config for commits
# GIT_AUTHOR_NAME=WW Update Agent
# GIT_AUTHOR_EMAIL=agent@whisperingwishes.app

# Optional: GitHub token for creating PRs (auto-provided in GitHub Actions)
# GITHUB_TOKEN=ghp_...

# Optional: Dry run mode (no file writes, no git commits)
# DRY_RUN=true
