# Required: Groq API key (from https://console.groq.com/keys)
GROQ_API_KEY=gsk_...

# Required for image management: imgbb API key (from https://api.imgbb.com/)
IMGBB_API_KEY=...

# Optional: Override model (default: llama-3.3-70b-versatile)
# GROQ_MODEL=llama-3.3-70b-versatile

# Optional: Git config for commits
# GIT_AUTHOR_NAME=WW Update Agent
# GIT_AUTHOR_EMAIL=agent@whisperingwishes.app

# Optional: GitHub token for creating PRs (auto-provided in GitHub Actions)
# GITHUB_TOKEN=ghp_...

# Optional: Dry run mode (no file writes, no git commits)
# DRY_RUN=true

# Optional: Run mode (full, micro, audit)
# RUN_MODE=full
